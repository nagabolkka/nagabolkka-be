# 외부 API 키
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KMA_SERVICE_KEY=
OPENAI_API_KEY=

# JWT 서명 키
JWT_SECRET=

# 카카오 회원번호 해시 키 (HMAC-SHA256, 32자 이상) : openssl rand -base64 48
HASH_SECRET=

# 카카오 회원번호 암호화 키 (AES-256 = 32바이트를 base64 로) : openssl rand -base64 32
AES_KEY=

# 운영 DB (EC2 docker-compose에서 사용, 로컬 H2 개발 시에는 비워둬도 됨)
DB_NAME=nagabolkka
DB_USERNAME=nagabolkka
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# AI 서버
AI_BASE_URL=http://localhost:8000
AI_INTERNAL_KEY=local-dev-key

KAKAO_ADMIN_KEY=

# 푸시 알림 (FCM) : Firebase 서비스 계정 JSON 을 base64 한 줄로 · 비워 두면 알림 발송 안 함
# base64 -i nagabolkka-firebase-adminsdk.json | tr -d '\n'
FIREBASE_CREDENTIALS_BASE64=

# 알림을 누르면 열 프론트 주소 (운영 https://nagabolkka.vercel.app)
APP_URL=http://localhost:5173